; Acoustic preset per static game material for snd_raytrace
; presets brick cloth concrete concrete_polished dirt glass grass gravel gyprock ice leaf marble metal mud rock sand snow tile tree water wood_indoor wood_outdoor
; optional keys absorption_lf absorption_hf scattering transmission_lf transmission_hf flat_transmission_lf flat_transmission_hf skip
; absorption_lf at 250 Hz and absorption_hf in the 4000 Hz octave, which holds the 5000 Hz reference, random incidence,
; from Vorlaender Auralization 2008 annex, Yang 2013 Sheffield thesis, Reethof 1976 and 1977, steel decking from the Adrian James table,
; water from the sengpielaudio RT60 table, gravel from the SDK preset
; scattering is the 707 Hz value of the ODEON 14 manual floored at 0.1, transmission copied from the preset,
; flat transmission from the game material's sound_occlusion_factor, the share a crossing keeps at 250 Hz, mass law to 5000 Hz
; transmission_lf and transmission_hf take no effect while every level and occluder primitive uses flat transmission

[default]
preset = concrete
absorption_lf = 0.03
absorption_hf = 0.07
scattering = 0.10
transmission_lf = 0.6
transmission_hf = 0.3

[default_passable]
preset = leaf
absorption_lf = 0.06
absorption_hf = 0.15
scattering = 0.10
transmission_lf = 5.0
transmission_hf = 1.0

