#include "hdr10_bloom.h"

float4 main(p_screen I) : SV_TARGET
{
    float x = I.tc0.x;
    float y = I.tc0.y;

    float3 game  = HDR10_SampleGameTexel(x, y);
    float3 bloom = HDR10_SampleBloomTexel(x, y);

    // add the bloom instead of crossfading so the base image is not darkened by the intensity
    float3 color = game + bloom * HDR10_BLOOM_INTENSITY;

    color = HDR10_LinearTosRGB(color);

    return float4(color, 1.0);
}
