// deffer_base_ext_flat.ps : deferred G-buffer pixel shader for external (GLTF/GLB) models that have
// only a base-color texture (no normal / metallic-roughness map). Mirrors the stock deffer_base_flat.ps
// (flat VS + interpolated vertex normal) but adds glTF alphaMode MASK support: it clips texels below
// the material's alphaCutoff. We use our OWN copy rather than the stock PS so the alpha-test plumbing
// (the ext_alpha_cutoff constant) never touches OGF geometry.
//
// Bind: s_base = albedo (with alpha in .a), sampler smp_base. Paired with deffer_model_flat.vs (p_flat).

#include "common.h"
#include "external_common.h"

// glTF alphaMode: .x = alphaCutoff for MASK materials; -1 for OPAQUE/BLEND (clip becomes a no-op).
// Set per-object in FExternalVisual::Render (RCache.set_c). Defaults harmlessly to 0 if never set.
float4 ext_alpha_cutoff;

f_deffer main( p_flat I )
{
	f_deffer O;

	float2 uv   = ext_uv( I.tcdh.xy );          // KHR_texture_transform
	float4 base = s_base.Sample( smp_base, uv );
	base.rgb   *= ext_base_color.rgb;           // glTF baseColorFactor tint
	base.a     *= ext_base_color.w;             // glTF baseColorFactor.a (alpha for the MASK test)

	// glTF MASK: discard texels with alpha below the cutoff. OPAQUE/BLEND pass -1 so nothing is clipped.
	clip( base.a - ext_alpha_cutoff.x );

	float ms = xmaterial;
	float h  = I.position.w;
#if defined(USE_R2_STATIC_SUN) && !defined(USE_LM_HEMI)
	ms = I.tcdh.w;
#endif

	float4 Ne = float4( normalize((float3)I.N.xyz), h );

	O = pack_gbuffer(
			Ne,
			float4( I.position.xyz, ms        ),
			float4( base.rgb,       def_gloss ) );

	return O;
}
