// deffer_base_ext_mr.ps : deferred G-buffer PS for external (GLTF/GLB) models with a glTF metallic-
// roughness map but NO normal map. Rendered through the external flat VS (deffer_model_flat_vc.vs):
// interpolated vertex normal, COLOR_0 (2.2), and per-map texCoord routing (3.5). The constant gloss is
// replaced by gloss derived from the MR map. Bind: s_base = albedo, s_bump = MR (G=rough, B=metal),
// s_ao = occlusion (R); = MR tex for ORM, else a separate AO map.

#include "common.h"
#include "external_common.h"

float4 ext_alpha_cutoff;   // glTF MASK cutoff (.x); -1 for OPAQUE/BLEND
float4 ext_ao_strength;    // glTF occlusionTexture.strength (.x); 0 = no occlusion
Texture2D s_ao;

struct p_flat_x
{
#if defined(USE_R2_STATIC_SUN) && !defined(USE_LM_HEMI)
	float4 tcdh     : TEXCOORD0;
#else
	float2 tcdh     : TEXCOORD0;
#endif
	float4 position : TEXCOORD1;
	float3 N        : TEXCOORD2;
	float2 tc1      : TEXCOORD3;
	float4 vcolor   : TEXCOORD5;
};

f_deffer main( p_flat_x I, bool front : SV_IsFrontFace )
{
	f_deffer O;

	float2 uv0     = ext_uv( I.tcdh.xy );                       // KHR-transformed UV0
	float2 base_uv = ext_uv_pick( uv0, I.tc1, ext_uv_set.x );
	float2 mr_uv   = ext_uv_pick( uv0, I.tc1, ext_uv_set.z );
	float2 ao_uv   = ext_uv_pick( uv0, I.tc1, ext_uv_set.w );

	float4 D = s_base.Sample( smp_base, base_uv );             // albedo (+ alpha in .a)
	D.rgb   *= ext_base_color.rgb * I.vcolor.rgb;              // glTF baseColorFactor + COLOR_0 tint
	D.a     *= ext_base_color.w * I.vcolor.a;                 // baseColorFactor.a * COLOR_0.a (MASK alpha)

	clip( D.a - ext_alpha_cutoff.x );

	float ms = xmaterial;
	float h  = I.position.w;
#if defined(USE_R2_STATIC_SUN) && !defined(USE_LM_HEMI)
	ms = I.tcdh.w;
#endif

	// glTF metallic-roughness (G=rough, B=metal), each scaled by its glTF factor.
	float2 mr       = s_bump.Sample( smp_base, mr_uv ).yz;
	float  rough    = saturate( mr.x * ext_mr_factor.y );
	float  metallic = saturate( mr.y * ext_mr_factor.x );

	// glTF occlusion: darken the ambient/hemi term by the AO map's R channel (no-op when strength 0).
	float  ao = s_ao.Sample( smp_base, ao_uv ).r;
	h *= lerp( 1.0h, ao, ext_ao_strength.x );

	float3 nrm = normalize((float3)I.N.xyz);
	if (!front) nrm = -nrm; // 3.2 doubleSided: flip the normal on back faces (no-op for single-sided)
	float4 Ne = float4( nrm, h );

	// Diffuse removed only for SMOOTH metal (mirror); ROUGH metal keeps albedo as a stable matte base.
	// metalness * smoothness, scaled by EXT_METAL_DIFFUSE_KILL so metals keep a flashlight-visible floor.
	float  smooth_m = metallic * ( 1.0h - rough ) * EXT_METAL_DIFFUSE_KILL;
	float3 albedo   = D.rgb * ( 1.0h - smooth_m );

	float  gloss    = saturate( 1.0h - rough );

	O = pack_gbuffer(
			Ne,
			float4( I.position.xyz, ms    ),
			float4( albedo,         gloss ) );

	return O;
}
